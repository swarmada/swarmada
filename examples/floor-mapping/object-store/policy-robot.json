{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnMapsInThisNamespace",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::floor-maps/warehouse-a/*"]
    },
    {
      "Sid": "NeverWriteAKeepOutSet",
      "Effect": "Deny",
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::floor-maps/warehouse-a/keepouts-*"]
    },
    {
      "Sid": "ReadOnlyTheKeepOutSets",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::floor-maps/warehouse-a/keepouts-*"]
    }
  ]
}
