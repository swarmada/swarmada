# ─────────────────────────────────────────────────────────────────────────────
# The floor-mapping demo's object store: the MinIO server and its client (mc), built
# from their public source at pinned release tags. A DEMO image, local to one kind
# cluster: it is never pushed, and nothing outside that cluster runs it.
#
# Built from source because MinIO no longer publishes community images. Each tag is
# checked against the commit it named when this file was written, so a moved tag
# fails the build instead of building something else. MinIO and mc are AGPL-3.0
# programs, run unmodified; nothing of this repository links to them.
#
#   docker build -f examples/floor-mapping/object-store/Dockerfile.minio \
#     -t swarmada-demo-minio:RELEASE.2025-09-07T16-13-09Z examples/floor-mapping/object-store
# ─────────────────────────────────────────────────────────────────────────────

FROM golang:1.24-bookworm AS build

ARG MINIO_TAG=RELEASE.2025-09-07T16-13-09Z
ARG MINIO_COMMIT=07c3a429bfed433e49018cb0f78a52145d4bedeb
ARG MC_TAG=RELEASE.2025-08-13T08-35-41Z
ARG MC_COMMIT=7394ce0dd2a80935aded936b09fa12cbb3cb8096

ENV CGO_ENABLED=0 GOFLAGS=-trimpath

WORKDIR /src
RUN git clone --quiet --depth 1 --branch "$MINIO_TAG" https://github.com/minio/minio.git minio \
 && test "$(git -C minio rev-parse HEAD)" = "$MINIO_COMMIT" \
 && git clone --quiet --depth 1 --branch "$MC_TAG" https://github.com/minio/mc.git mc \
 && test "$(git -C mc rev-parse HEAD)" = "$MC_COMMIT"
RUN cd minio && go build -o /out/minio . && cd ../mc && go build -o /out/mc .

FROM debian:bookworm-slim
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ca-certificates >/dev/null \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/minio /out/mc /usr/local/bin/
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/minio"]
