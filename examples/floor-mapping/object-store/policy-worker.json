{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadMapsInThisNamespace",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::floor-maps/warehouse-a/*"]
    },
    {
      "Sid": "ListOnlyThisNamespace",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::floor-maps"],
      "Condition": {"StringLike": {"s3:prefix": ["warehouse-a/*"]}}
    },
    {
      "Sid": "WriteOnlyKeepOutSets",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": ["arn:aws:s3:::floor-maps/warehouse-a/keepouts-*"]
    }
  ]
}
