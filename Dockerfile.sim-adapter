# ─────────────────────────────────────────────────────────────────────────────
# Reference simulation Fleet Adapter image (adapters/simulation/sim_adapter.py).
#
# Lets a cluster run the reference sim adapter as a Deployment instead of as a
# process started beside it — see config/overlays/demo-webhooks/sim-adapter/.
# It is a DEMO image: one simulated robot, kinematic plant, no hardware.
#
#   docker build -f Dockerfile.sim-adapter -t swarmada-sim-adapter:dev .
#   kind load docker-image swarmada-sim-adapter:dev --name <cluster>
#
# The build context is narrowed by Dockerfile.sim-adapter.dockerignore to the
# files the adapter imports: the adapter and its scenario presets, the committed
# Python protobuf stubs, and the SDK's shared safety primitives. sim_adapter.py
# puts the repository root and sdk/python/src on sys.path itself, so the layout
# under /app mirrors the repository and nothing is pip-installed from the tree.
# ─────────────────────────────────────────────────────────────────────────────

FROM python:3.12-slim

# Runtime dependencies, pinned to the versions uv.lock resolves for the repository
# (pyproject.toml: grpcio>=1.62, protobuf>=6.33.5 — the stubs are gencode 6.33.5 and
# refuse an older runtime — and pyyaml>=6.0 for the scenario presets).
RUN pip install --no-cache-dir grpcio==1.83.0 protobuf==6.33.6 pyyaml==6.0.3

WORKDIR /app
COPY adapters/__init__.py adapters/__init__.py
COPY adapters/simulation/ adapters/simulation/
COPY adapters/scenarios/ adapters/scenarios/
COPY proto/fleet_adapter/v1/fleet_adapter_pb2.py proto/fleet_adapter/v1/fleet_adapter_pb2_grpc.py proto/fleet_adapter/v1/
COPY sdk/python/src/swarmada_sdk/ sdk/python/src/swarmada_sdk/
# COPY keeps the checkout's file modes, which need not be world-readable; the
# adapter runs as a non-root uid below and must be able to read what it imports.
RUN chmod -R a+rX /app

# PYTHONPATH=proto is how every other caller runs this file. Unbuffered output so
# `kubectl logs` shows the NOT_ADMITTED / announce lines as they happen; no bytecode
# so the root filesystem can be mounted read-only.
ENV PYTHONPATH=/app/proto \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# The adapter needs no privileges: it dials out over gRPC and reads its client
# certificate from a mounted Secret. 65532 is the distroless "nonroot" uid the
# manager and edge images run as.
USER 65532:65532

ENTRYPOINT ["python3", "/app/adapters/simulation/sim_adapter.py"]
