#!/usr/bin/env bash
# pre-push — run the publication boundary guard before anything leaves the machine.
#
# Install with:  make hooks
#
# WHY PRE-PUSH AND NOT PRE-COMMIT
#
# The failure this exists to stop is that something reached GitHub, not that something
# reached a local commit. Local commits get amended, rebased and dropped all day; push
# is the irreversible step. Running here also means the check sees the whole tree being
# pushed rather than one commit at a time.
#
# WHY STRICT
#
# The guard exits 0 for warn-severity findings. One warn-severity rule covers the
# vocabulary that must not appear on a published standard surface, and warn is right
# for the authoring tree — its pattern cannot tell prose about the market from prose
# about this project. On the published tree it is not advisory: a gate that let those
# findings through is why they stayed live, and on GitHub, for weeks. So this hook
# fails on warnings too.
#
# To push anyway, having read the findings and judged them:
#
#   git push --no-verify
#
# A contributor without the authoring tree can set SKIP_IF_UNAVAILABLE=1; it prints a
# loud notice rather than passing silently.

set -euo pipefail

root=$(git rev-parse --show-toplevel)
checker="$root/scripts/check-publication-boundary.sh"

[ -x "$checker" ] || exit 0

echo "pre-push: publication boundary guard (STRICT) …" >&2

rc=0
STRICT=1 "$checker" || rc=$?

if [ "$rc" -eq 0 ]; then
  echo "pre-push: boundary clean." >&2
  exit 0
fi

echo "" >&2
echo "pre-push: BLOCKED — the boundary guard rejected this tree (exit $rc)." >&2
echo "pre-push: fix the findings above, or push with --no-verify if you have judged them." >&2
exit 1
